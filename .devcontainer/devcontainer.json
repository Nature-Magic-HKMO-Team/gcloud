{
  "name": "GCloud Dev Container",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/google-cloud-cli:1": {}
  },
  "postCreateCommand": "if [ -n \"${GCP_SA_KEY}\" ]; then echo \"${GCP_SA_KEY}\" > /tmp/gcp_key.json; fi",
  "remoteEnv": {
    "GOOGLE_APPLICATION_CREDENTIALS": "/tmp/gcp_key.json"
  }
}